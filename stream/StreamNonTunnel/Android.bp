soong_config_module_type {
    name: "stream_nontunnel_cc_library_headers",
    module_type: "cc_library_headers",
    config_namespace: "qti",
    bool_variables: ["AUDIO_SDV_APEX_ENABLED"],
    properties: [
        "apex_available",
    ],
}

stream_nontunnel_cc_library_headers {
    name: "libstream_nontunnel_headers",
    export_include_dirs: ["inc"],
    vendor: true,
    soong_config_variables: {
        AUDIO_SDV_APEX_ENABLED: {
            apex_available: [
                "//apex_available:platform",
                "//apex_available:anyapex",
            ],
        },
    },
}

cc_library {

    name: "libstream_nontunnel",
    owner: "qti",
    vendor: true,

    srcs: [
        "src/StreamNonTunnel.cpp",
    ],

    shared_libs: [
        "liblog",
        "libcutils",
        "liblx-osal",
        "libar-pal",
        "libexpat",
        "libar-gsl", //remove after cleaning up getTagsWithModuleInfo
        "libaudioroute",
        ],

    include_dirs: [
        "vendor/qcom/opensource/pal/stream/StreamNonTunnel/inc",
        "system/media/audio_route/include",
        "vendor/qcom/opensource/pal",
        ],

    cppflags: [
        "-fexceptions", "-frtti",
        ],

    header_libs: [
        "libarpal_headers",
        "libspf-headers",
        "libvui_dmgr_headers",
        "libarvui_intf_headers",
        "libaudiofeaturestats_headers",
        "liblisten_headers",
        "libacdb_headers",
        "libarpal_internalheaders",
        "libarmemlog_headers",
        ],

    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    enabled: select(soong_config_variable("qti", "AUDIO_SDV_APEX_ENABLED"), {
        "true": true,
        default: false,
    }),
}
