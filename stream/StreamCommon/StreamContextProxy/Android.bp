cc_library_headers {

    name: "libstream_contextproxy_headers",
    export_include_dirs: ["inc"],
    vendor: true,

    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
}

cc_library {

    name: "libstream_contextproxy",
    owner: "qti",
    vendor: true,

    srcs: [
       "src/StreamContextProxy.cpp",
    ],

    shared_libs: [
        "liblog",
        "libcutils",
        "liblx-osal",
        "libar-pal",
        "libexpat",
        "libstream_common",
        "libaudioroute",
        ], 

    include_dirs: [
        "vendor/qcom/opensource/pal/stream/StreamCommon/StreamContextProxy/inc",
        "system/media/audio_route/include",
        "vendor/qcom/opensource/args/gsl/api",
        "vendor/qcom/opensource/pal",
        ],

    cppflags: [
        "-fexceptions",
        ],

    header_libs: [
        "libstream_common_headers",
        "libarpal_headers",
        "libspf-headers",
        "libvui_dmgr_headers",
        "libarvui_intf_headers",
        "libaudiofeaturestats_headers",
        "liblisten_headers",
        "libacdb_headers",
        "libarpal_internalheaders",
        "libarmemlog_headers",
        ],


        enabled: select(soong_config_variable("qti", "AUDIO_SDV_APEX_ENABLED"), {
        "true": true,
        default: false,
    }),
apex_available: [
    "//apex_available:platform",
    "//apex_available:anyapex",
],
}
