cc_library_shared {

    name: "libcustomva_intf",
    owner: "qti",
    vendor: true,

    srcs: [
        "src/CustomVAInterface.cpp"
        ],

    shared_libs: [
        "liblog",
        "libcutils",
        "liblx-osal",
        ],

    include_dirs: [
        "vendor/qcom/opensource/pal/plugins/customva_intf/inc",
        ],

    cppflags: [
        "-fexceptions",
        ],

    header_libs: [
        "libarpal_headers",
        "libarvui_intf_headers",
        "libspf-headers",
        "liblisten_headers",
        "libarosal_headers",
        ],

        enabled: select(soong_config_variable("qti", "AUDIO_SDV_APEX_ENABLED"), {
        "true": true,
        default: false,
    }),
apex_available: [
    "//apex_available:platform",
    "//apex_available:anyapex",
],
}


