cc_library_shared {

    name: "lib_default_plugin_controls",
    owner: "qti",
    vendor: true,

    srcs: [
        "defaultPluginControls.cpp"
        ],

    shared_libs: [
            "libcutils",
            "liblog",
            "libdl",
            "libexpat",
            "libar-pal",
            "libsession_ar",
            "libqti-tinyalsa",
            "libqti-tinycompress",
            ],

    include_dirs: [
            "vendor/qcom/opensource/pal",
            "vendor/qcom/opensource/pal/session/inc",
            "vendor/qcom/opensource/pal/session/SessionAR/inc",
            "vendor/qcom/opensource/pal/stream/inc",
            "vendor/qcom/opensource/pal/resource_manager/inc",
            "vendor/qcom/opensource/pal/device/inc",
            "vendor/qcom/opensource/pal/utils/inc",
            "vendor/qcom/opensource/pal/context_manager/inc",
            "vendor/qcom/opensource/pal/plugins/PluginManager/inc",
            "system/media/audio_route/include",
            "system/media/audio/include",
            "external/expat/lib",
            "vendor/qcom/opensource/tinycompress/include",
            ],

    cflags: [
        "-O2",
        "-fvisibility=hidden",
        ],

    header_libs: [
        "libspf-headers",
        "libagm_headers",
        "libarosal_headers",
        "libaudiologutils_headers",
        "libacdb_headers",
        "liblisten_headers",
        "libarvui_intf_headers",
        "libsession_ar_headers",
        "libaudiofeaturestats_headers",
        "plugin_manager_headers",
        "libsession_voice_headers",
        ],

        enabled: select(soong_config_variable("qti", "AUDIO_SDV_APEX_ENABLED"), {
        "true": true,
        default: false,
    }),
apex_available: [
    "//apex_available:platform",
    "//apex_available:anyapex",
],
}

