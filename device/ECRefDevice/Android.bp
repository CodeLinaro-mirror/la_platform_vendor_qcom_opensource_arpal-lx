soong_config_module_type {
    name: "ecref_cc_library_headers",
    module_type: "cc_library_headers",
    config_namespace: "qti",
    bool_variables: ["AUDIO_SDV_APEX_ENABLED"],
    properties: [
        "apex_available",
    ],
}

ecref_cc_library_headers {
    name: "libdev_ecref_headers",
    export_include_dirs: ["inc"],
    vendor: true,
    soong_config_variables: {
        AUDIO_SDV_APEX_ENABLED: {
            apex_available: [
                "//apex_available:platform",
                "//apex_available:anyapex",
            ],
        },
    },
}

cc_library {

    name: "libdev_ec_ref",
    owner: "qti",
    vendor: true,

    srcs: [
        "src/ECRefDevice.cpp",
        ],

    shared_libs: [
        "liblog",
        "libcutils",
        "liblx-osal",
        "libar-pal",
        "libexpat",
        "libutilscallstack",
        "libsession_ar",
        "libqti-tinyalsa",
        "libqti-tinycompress"
    ],

    include_dirs: [
            "vendor/qcom/opensource/pal/device/ECRefDevice/inc",
            "system/media/audio_route/include",
            "system/media/audio/include",
            "vendor/qcom/opensource/pal",
            "vendor/qcom/opensource/tinycompress/include",
            ],

    cppflags: [
        "-fexceptions",
        "-frtti",
        ],

    rtti: true,

    header_libs: [
        "libarpal_headers",
        "libspf-headers",
        "libacdb_headers",
        "liblisten_headers",
        "libarosal_headers",
        "libaudiofeaturestats_headers",
        "libarvui_intf_headers",
        "libarmemlog_headers",
        "libarpal_internalheaders",
        "libsession_ar_headers",
        ],

    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    enabled: select(soong_config_variable("qti", "AUDIO_SDV_APEX_ENABLED"), {
        "true": true,
        default: false,
    }),
}
