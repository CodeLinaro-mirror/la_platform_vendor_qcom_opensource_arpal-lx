soong_config_module_type {
    name: "headsetva_cc_library_headers",
    module_type: "cc_library_headers",
    config_namespace: "qti",
    bool_variables: ["AUDIO_SDV_APEX_ENABLED"],
    properties: [
        "apex_available",
    ],
}

headsetva_cc_library_headers {
    name: "libdev_headsetva_headers",
    export_include_dirs: ["inc"],
    vendor: true,
    soong_config_variables: {
        AUDIO_SDV_APEX_ENABLED: {
            apex_available: [
                "//apex_available:platform",
                "//apex_available:anyapex",
            ],
        },
    },
}

cc_library {

    name: "libdev_headset_va",
    owner: "qti",
    vendor: true,

    srcs: [
        "src/HeadsetVaMic.cpp",
        ],

    shared_libs: [
            "liblog",
            "libcutils",
            "liblx-osal",
            "libar-pal",
            "libexpat",
            "libutilscallstack",
            ]
        + select(soong_config_variable("qti", "TARGET_USES_QTI_TINYCOMPRESS"), {
            true: ["libqti-tinyalsa", "libqti-tinycompress"],
            default: ["libqti-tinyalsa", "libqti-tinycompress"],
        }),

    include_dirs: [
            "vendor/qcom/opensource/pal/device/HeadsetVaMic/inc",
            "system/media/audio_route/include",
            "system/media/audio/include",
            "vendor/qcom/opensource/pal",
            ]
        + select(soong_config_variable("qti", "TARGET_USES_QTI_TINYCOMPRESS"), {
            true: [],
            default: ["external/tinycompress/include"],
        }),

    cppflags: [
        "-fexceptions",
        "-frtti",
        ],

    header_libs: [
        "libarpal_headers",
        "libspf-headers",
        "libagm_headers",
        "libacdb_headers",
        "liblisten_headers",
        "libarosal_headers",
        "libaudiofeaturestats_headers",
        "libarvui_intf_headers",
        "libarmemlog_headers",
        "libarpal_internalheaders",
        ],

    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    enabled: select(soong_config_variable("qti", "AUDIO_SDV_APEX_ENABLED"), {
        "true": true,
        default: false,
    }),
}
