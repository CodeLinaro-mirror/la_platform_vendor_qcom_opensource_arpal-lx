cc_library_headers {

    name: "libdev_haptics_headers",
    export_include_dirs: ["inc"],
    vendor: true,

    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
}

cc_library {

    name: "libdev_haptics",
    owner: "qti",
    vendor: true,

    srcs: [
        "src/HapticsDev.cpp",
        "src/HapticsDevProtection.cpp",
        ],

    shared_libs: [
            "liblog",
            "libcutils",
            "liblx-osal",
            "libar-pal",
            "libexpat",
            "libaudioroute",
            "libutilscallstack",
            "libsession_ar",
            ]
        + select(soong_config_variable("qti", "TARGET_USES_QTI_TINYCOMPRESS"), {
            true: ["libqti-tinyalsa", "libqti-tinycompress"],
            default: ["libqti-tinyalsa", "libqti-tinycompress"],
        }),

    include_dirs: [
            "vendor/qcom/opensource/pal/device/HapticsDev/inc",
            "system/media/audio_route/include",
            "system/media/audio/include",
            "vendor/qcom/opensource/pal",
            ]
        + select(soong_config_variable("qti", "TARGET_USES_QTI_TINYCOMPRESS"), {
            true: [],
            default: ["external/tinycompress/include"],
        }),

    cppflags: [
        "-fexceptions",
        "-frtti",
        ],

    rtti: true,

    header_libs: [
        "libarpal_headers",
        "libspf-headers",
        "libagm_headers",
        "libacdb_headers",
        "liblisten_headers",
        "libarosal_headers",
        "libaudiofeaturestats_headers",
        "libarvui_intf_headers",
        "libarmemlog_headers",
        "libarpal_internalheaders",
        "libdev_speaker_headers",
        "libsession_ar_headers",
        ],

        enabled: select(soong_config_variable("qti", "AUDIO_SDV_APEX_ENABLED"), {
        "true": true,
        default: false,
    }),
apex_available: [
    "//apex_available:platform",
    "//apex_available:anyapex",
],
}

